// 1. Function with Multiple Return Values & Type Inference
func divide(a: int, b: int) (int, bool) {
    if b == 0 {
        return 0, false
    }
    return a / b, true
}

// 2. Main Logic
val res, ok = divide(10, 2)
if ok {
    print("Division Result: {res}")
}

// 3. Dec Type Widening & Math Module
val root: dec = math.sqrt(16)
print("Square Root of 16 is: {root}")

